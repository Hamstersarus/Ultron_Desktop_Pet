{
  "name": "ultron_desktop_pet",
  "version": "1.1.0",
  "description": "An Ultron desktop pet you can talk to",
  "main": "main.js",
  "homepage": "https://hamstersarus.github.io/Ultron_Desktop_Pet/",
  "author": {
    "name": "Hamstersarus",
    "email": "Hamstersarus@users.noreply.github.com"
  },
  "license": "ISC",
  "type": "commonjs",
  "scripts": {
    "start": "electron . --ozone-platform=x11",
    "dist": "electron-builder"
  },
  "devDependencies": {
    "electron": "^44.7.0",
    "electron-builder": "^26.15.3"
  },
  "allowScripts": {
    "electron": true
  },
  "build": {
    "appId": "io.github.hamstersarus.ultronpet",
    "productName": "Ultron",
    "files": [
      "main.js",
      "preload.js",
      "renderer.js",
      "index.html",
      "assets/**/*"
    ],
    "icon": "assets/icon.png",
    "linux": {
      "target": ["deb", "AppImage"],
      "category": "Utility",
      "artifactName": "Ultron.${ext}"
    },
    "win": {
      "target": "nsis",
      "artifactName": "Ultron-Setup.${ext}"
    },
    "mac": {
      "target": {
        "target": "dmg",
        "arch": ["universal"]
      },
      "artifactName": "Ultron.${ext}"
    }
  }
}
